# git
alias gs="git status"
alias gc="git commit"
alias gca="git commit --amend --no-edit"
alias gitlog="git log --all --graph --decorate"

# general
alias mv="mv -i" # Make move ask before overwriting
alias kw="date +%V"
alias fd="fdfind"
# on wayland, xclip is unreliabe
if [ "$XDG_SESSION_TYPE" = "wayland" ]; then
    if command -v wl-copy &> /dev/null; then
        alias clip='wl-copy'
    else
        alias clip='echo "wl-copy not installed. Run: sudo apt install wl-clipboard" >&2'
    fi
else
    alias clip='xclip -selection clipboard'
fi

# Add an "alert" alias for long running commands.  Use like so:
#   sleep 10; alert
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'

alias prime-run='__NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia'

# make dir and change to it
function mcd() {
	mkdir -p $1 && cd $1
}
